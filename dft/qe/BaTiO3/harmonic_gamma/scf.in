&CONTROL
    calculation = 'scf'
    restart_mode = 'from_scratch'
    prefix = 'BaTiO3_pristine'
    pseudo_dir = './pseudo/'
    outdir = './tmp/'
    tstress = .true.               ! sanity: residual pressure ~0
    tprnfor = .true.                ! sanity: forces ~0 by symmetry
/
&SYSTEM
    ibrav = 1
    celldm(1) = 7.606726           ! = 7.57 * 1.004851461 (vc-relax scale factor)
                                    ! = 4.0253 A. NOT the 7.570000 echoed in
                                    ! vc_relax.out -- that is the input value.
    nat = 5
    ntyp = 3
    ecutwfc = 60.0
    ecutrho = 480.0
    occupations = 'fixed'
/
&ELECTRONS
    conv_thr = 1.0d-12
    mixing_beta = 0.3
/
ATOMIC_SPECIES
 Ba  137.327  Ba.pbe-spn-kjpaw_psl.1.0.0.UPF
 Ti  47.867   Ti.pbe-spn-kjpaw_psl.1.0.0.UPF
 O   15.999   O.pbe-n-kjpaw_psl.1.0.0.UPF
ATOMIC_POSITIONS crystal
 Ba  0.000000000  0.000000000  0.000000000
 Ti  0.500000000  0.500000000  0.500000000
 O   0.500000000  0.500000000  0.000000000
 O   0.500000000  0.000000000  0.500000000
 O   0.000000000  0.500000000  0.500000000
K_POINTS automatic
 8 8 8 0 0 0
