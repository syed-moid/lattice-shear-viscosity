BaTiO3 pristine -- phonon dispersion, 4x4x4 q-grid (harmonic)
!! STAGED ONLY -- DO NOT RUN until the Gamma-point results have been reviewed.
&inputph
    prefix    = 'BaTiO3_pristine'
    outdir    = './tmp/'
    fildyn    = 'BaTiO3.dyn'
    ldisp     = .true.
    nq1 = 4, nq2 = 4, nq3 = 4
    tr2_ph    = 1.0d-14
    verbosity = 'high'
    recover   = .false.
/
! Same notes as the STO dispersion run apply: no epsil with ldisp (verify
! dyn1 carries the Dielectric Tensor block after the run); expect 10
! irreducible q-points; ~8h-class job -> launch detached.
! EXPECTED PHYSICS difference from STO: the FE soft branch should be
! DEEPER at Gamma and stay unstable across extended zone regions, but the
! R-point AFD instability should be ABSENT or nearly so -- BaTiO3 does not
! share SrTiO3's octahedral-rotation instability. That contrast is a key
! cross-material check (and a paper figure).
