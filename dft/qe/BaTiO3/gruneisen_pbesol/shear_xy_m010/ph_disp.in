BaTiO3 shear_xy_m010 -- strained-cell phonon dispersion for mode Grueneisen (4x4x4 grid)
&inputph
    prefix    = 'BaTiO3_pbesol_shear_xy_m010'
    outdir    = './tmp/'
    fildyn    = 'BaTiO3_pbesol_shear_xy_m010.dyn'
    ldisp     = .true.
    nq1 = 4, nq2 = 4, nq3 = 4
    tr2_ph    = 1.0d-14
    verbosity = 'high'
    recover   = .false.
/
